# Mesmo token do ResenhaFC (REACT_APP_MAPBOX_ACCESS_TOKEN)
MAPBOX_ACCESS_TOKEN=
# Emulador Android → host machine
SYNC_API_BASE=http://10.0.2.2:8080
# true = limpa e popula banco demo no boot (mercados com lat/lng, preços, carrinho)
SEED_DEMO=false
# true = remove dados do seed no boot (preserva auth); use via `make seed-clear`
CLEAR_SEED_DEMO=false
