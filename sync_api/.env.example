PORT=8080
# Deixe vazio para store em memória (dev sem Atlas).
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/pegou_preco?retryWrites=true&w=majority
MONGODB_DB=pegou_preco

# Gmail SMTP (App Password) — nunca commitar valores reais.
EMAIL_USER=
EMAIL_PASS=
EMAIL_LOGO_URL=
# true = pula verificação por e-mail (só dev/test).
# Confirmação de conta no PegouPreço é por e-mail (OTP).
SKIP_EMAIL_VERIFICATION=false

# SMS via Twilio (legado/opcional). O app envia OTP por e-mail.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SKIP_SMS_VERIFICATION=true

# Em store memory já fica true. Em prod, deixe false.
EXPOSE_OTP_IN_RESPONSE=false

# Jev (TypeSafe) — classificação de preços. Nunca expor no app.
JEV_API_KEY=

# E-mails com acesso admin (CRUD de supermercados). Separados por vírgula.
# Ex.: ADMIN_EMAILS=voce@email.com
ADMIN_EMAILS=
